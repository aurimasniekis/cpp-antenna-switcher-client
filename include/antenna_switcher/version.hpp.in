#pragma once

/// @file
/// @brief Library version constants (configured from CMake's project version).

// NOLINTBEGIN(cppcoreguidelines-macro-to-enum,modernize-macro-to-enum)
#define ANTENNA_SWITCHER_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ANTENNA_SWITCHER_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ANTENNA_SWITCHER_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ANTENNA_SWITCHER_VERSION_STRING "@PROJECT_VERSION@"
// NOLINTEND(cppcoreguidelines-macro-to-enum,modernize-macro-to-enum)

namespace antenna_switcher {

/// Library version, e.g. "0.4.1".
inline constexpr const char* version = ANTENNA_SWITCHER_VERSION_STRING;

}  // namespace antenna_switcher
